{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/crew.py\" hook guard-bash", "timeout": 10}
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/crew.py\" hook guard-files", "timeout": 10}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/crew.py\" hook size", "timeout": 10},
          {"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/crew.py\" hook rename", "timeout": 15}
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/crew.py\" hook start", "timeout": 10}
        ]
      }
    ]
  }
}
